# Gemini API key for the server-side Gemini endpoints.
GEMINI_API_KEY="your-gemini-api-key"

# Optional OpenRouter key for server-side OpenRouter requests.
# Obtain a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Local or production URL used by your deployment tooling.
APP_URL="http://localhost:3000"


