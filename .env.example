# Gemini API key for the server-side Gemini endpoints.
GEMINI_API_KEY="your-gemini-api-key"

# Optional OpenRouter key for server-side OpenRouter requests.
# Obtain a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Local or production URL used by your deployment tooling.
APP_URL="http://localhost:3000"

# On Vercel, set APP_URL to your deployed URL, for example:
# APP_URL="https://llm-code-review-agent.vercel.app"

# Firebase web app configuration used by Google Sign-In.
# These are client-side identifiers, not OAuth client secrets.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID=""


